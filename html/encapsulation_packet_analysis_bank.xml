<section ident="root_section">

<!-- Q1 -->
<item ident="Q1" title="OSI Data Link Layer">
<presentation>
<material><mattext>Which OSI layer adds MAC addresses during encapsulation?</mattext></material>
<response_lid ident="r1" rcardinality="Single">
<render_choice>
<response_label ident="A"><material><mattext>Network</mattext></material></response_label>
<response_label ident="B"><material><mattext>Transport</mattext></material></response_label>
<response_label ident="C"><material><mattext>Data Link</mattext></material></response_label>
<response_label ident="D"><material><mattext>Application</mattext></material></response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing><respcondition><conditionvar><varequal respident="r1">C</varequal></conditionvar></respcondition></resprocessing>
</item>

<!-- Q2 -->
<item ident="Q2" title="Encapsulation Order">
<presentation>
<material><mattext>What is the correct order of encapsulation?</mattext></material>
<response_lid ident="r2" rcardinality="Single">
<render_choice>
<response_label ident="A"><material><mattext>Application → Transport → Network → Data Link</mattext></material></response_label>
<response_label ident="B"><material><mattext>Network → Transport → Application → Data Link</mattext></material></response_label>
<response_label ident="C"><material><mattext>Transport → Network → Application → Data Link</mattext></material></response_label>
<response_label ident="D"><material><mattext>Application → Network → Transport → Data Link</mattext></material></response_label>
</render_choice>
</response_lid>
</presentation>
<resprocessing><respcondition><conditionvar><varequal respident="r2">A</varequal></conditionvar></respcondition></resprocessing>
</item>

